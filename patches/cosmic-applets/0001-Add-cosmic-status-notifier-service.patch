 %cargo_test
 %endif
 
+%post
+%systemd_user_post com.system76.CosmicStatusNotifierWatcher.service
+
 %files
 %license LICENSE
 %license LICENSE.dependencies
@@ -134,6 +137,8 @@ export VERGEN_GIT_SHA="%{commit}"
 %{_bindir}/cosmic-applet-tiling
 %{_bindir}/cosmic-applet-time
