From 5b858322a77a627a51f91269335499dbee76e1e6 Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Sat, 20 Sep 2025 00:47:52 -0500
Subject: [PATCH] license: Remove extra data from license versions

Signed-off-by: Ryan Brue <ryanbrue.dev@gmail.com>
---
 cosmic-applets.spec | 1 +
 1 file changed, 1 insertion(+)

diff --git a/cosmic-applets.spec b/cosmic-applets.spec
index a9b0e8a..f9be13a 100644
--- a/cosmic-applets.spec
+++ b/cosmic-applets.spec
@@ -79,6 +79,7 @@ export VERGEN_GIT_SHA="%{commit}"
 %{cargo_license} > LICENSE.dependencies
 %{cargo_vendor_manifest}
 sed 's/\(.*\) (.*#\(.*\))/\1+git\2/' -i cargo-vendor.txt
+sed 's/^\([^+]*\)+.*+\([^+]*\)$/\1+\2/' -i cargo-vendor.txt
 
 %install
 # Set vergen environment variables
