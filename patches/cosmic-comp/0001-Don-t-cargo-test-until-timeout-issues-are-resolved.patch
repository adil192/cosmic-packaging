--- a/cosmic-comp.spec
+++ b/cosmic-comp.spec
@@ -93,7 +93,8 @@ make install DESTDIR=%{buildroot} prefix=%{_prefix}
 export VERGEN_GIT_COMMIT_DATE="date --utc '%{commitdatestring}'"
 export VERGEN_GIT_SHA="%{commit}"
 export GIT_HASH="%{commit}"
