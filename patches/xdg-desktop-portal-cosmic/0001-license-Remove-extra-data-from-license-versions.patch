From 1a037db1a055a7552a47d10ef897c066b411fb96 Mon Sep 17 00:00:00 2001
From: Ryan Brue <ryanbrue.dev@gmail.com>
Date: Sat, 20 Sep 2025 00:49:29 -0500
Subject: [PATCH] license: Remove extra data from license versions

Signed-off-by: Ryan Brue <ryanbrue.dev@gmail.com>
---
 xdg-desktop-portal-cosmic.spec | 1 +
 1 file changed, 1 insertion(+)

diff --git a/xdg-desktop-portal-cosmic.spec b/xdg-desktop-portal-cosmic.spec
index 83efb0a..d72f046 100644
--- a/xdg-desktop-portal-cosmic.spec
+++ b/xdg-desktop-portal-cosmic.spec
@@ -76,6 +76,7 @@ export VERGEN_GIT_SHA="%{commit}"
 %{cargo_license} > LICENSE.dependencies
 %{cargo_vendor_manifest}
 sed 's/\(.*\) (.*#\(.*\))/\1+git\2/' -i cargo-vendor.txt
+sed 's/^\([^+]*\)+.*+\([^+]*\)$/\1+\2/' -i cargo-vendor.txt
 
 %install
 # Set vergen environment variables
